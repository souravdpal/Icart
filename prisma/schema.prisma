generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cart {
  id         String @id
  user_id    String
  product_id String
  amount     Int
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id               String   @id @db.VarChar(20)
  title            String   @db.VarChar(255)
  description      String?
  category         String   @db.VarChar(100)
  brand            String   @db.VarChar(100)
  price            Int
  original_price   Int
  discount_percent Int      @default(0) @db.SmallInt
  rating           Decimal? @db.Decimal(2, 1)
  review_count     Int      @default(0)
  tag              String?  @db.VarChar(30)
  is_new           Boolean  @default(false)
  stock            Int      @default(0)
  image            String?
  affiliate_url    String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
}

model session {
  id            String @id @db.Char(40)
  session       String @unique @db.Char(40)
  refresh_token String @unique @db.Char(40)
  session_exp   BigInt
  refresh_exp   BigInt
  user_id       String @db.Char(40)
}

model users {
  id           String  @id @db.VarChar(40)
  username     String  @unique @db.VarChar(50)
  name         String  @db.VarChar(50)
  email        String  @unique @db.VarChar(100)
  passwordhash String  @unique @db.VarChar(225)
  address      String?
  phone        String? @db.VarChar(15)
  ip           String?
  user_agent   String?
}
